---
import '../styles/global.css';
import '../styles/enquiry-form.css';
const turnstileKey = import.meta.env.DEV ? '' : (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '').trim();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/dm-sans-latin-v17.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-v23.woff2" as="font" type="font/woff2" crossorigin />
    <title>Contact ICT Mates | Tell us about your project</title>
    <meta name="description" content="Contact ICT Mates in Lahore about Webstore.pk, web and mobile development, design, digital marketing or custom software." />
    <link rel="canonical" href="https://ictmates.com/contact/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#101b8e" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="announcement">Your technology partner in Pakistan <span>·</span> Home of Webstore.pk</div>
    <header class="site-header">
      <div class="header wrap">
        <a class="logo" href="/" aria-label="ICT Mates home"><img src="/ictmates-logo.png" alt="ICT Mates" width="1000" height="333" /></a>
        <button class="menu-toggle" type="button" aria-controls="header-menu" aria-expanded="false">Menu</button>
        <div class="header-menu" id="header-menu">
          <nav aria-label="Main navigation"><a href="/">Home</a><a href="/#features">Webstore.pk</a><a href="/#services">Services</a><a href="/partners/">Partners</a><a href="/#about">About us</a></nav>
          <a class="button small" href="#contact-enquiry">Send an enquiry ↓</a>
        </div>
      </div>
    </header>
    <main id="main" class="contact-page">
      <section class="contact wrap" aria-labelledby="contact-title">
        <div>
          <div class="eyebrow">CONTACT ICT MATES</div>
          <h1 id="contact-title">Let’s talk about<br />your project.</h1>
          <p>Tell us what you have in mind for your website, webshop or software. Our team in Lahore can help you work out the next step.</p>
          <div class="direct-contact">
            <a class="button lime" href="https://wa.me/923005551575" target="_blank" rel="noopener noreferrer">Chat on WhatsApp ↗︎</a>
            <a class="text-link" href="tel:+923005551575">+92 300 555 1575</a>
            <p>Building 13, Block J, Gulberg III<br />Lahore, Pakistan</p>
            <a class="text-link" href="/partners/">Ask about partnering with us ↗︎</a>
          </div>
        </div>
        <div class="enquiry-panel">
          <form id="contact-enquiry" aria-labelledby="enquiry-title" method="post" action="/api/enquiry.php" data-captcha-key={turnstileKey} data-enquiry-action="contact">
            <div class="botcheck" aria-hidden="true"><label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
            <h2 id="enquiry-title">Send us an enquiry</h2>
            <p class="form-intro"><span class="required-mark" aria-hidden="true">*</span> Required fields</p>
            <div class="form-fields">
              <div class="form-field"><label for="contact-name">Your name <span class="required-mark" aria-hidden="true">*</span></label><input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required /></div>
              <div class="form-field"><label for="contact-email">Your email <span class="required-mark" aria-hidden="true">*</span></label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
              <div class="form-field"><label for="contact-phone">Phone number <span class="optional-label">(optional)</span></label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></div>
              <div class="form-field"><label for="contact-message">How can we help? <span class="required-mark" aria-hidden="true">*</span></label><textarea id="contact-message" name="message" rows="5" maxlength="2000" required></textarea></div>
            </div>
            <div data-captcha></div>
            <p class="form-status" data-captcha-status aria-live="polite"></p>
            <div class="enquiry-actions"><button class="button" id="send-email" type="submit" disabled aria-describedby="email-status">Send enquiry by email ↗︎</button></div>
            <p id="email-status" class="form-status email-status" role="status">{turnstileKey ? 'Our team will reply to the email address you provide.' : import.meta.env.DEV ? 'Email delivery is disabled in the local preview. WhatsApp is available.' : 'Email is temporarily unavailable. Please use WhatsApp.'}</p>
            <noscript><p class="form-status">Enable JavaScript to send an email enquiry, or use the WhatsApp link on this page.</p></noscript>
          </form>
        </div>
      </section>
    </main>
    <footer class="wrap footer"><a class="logo" href="/"><img src="/ictmates-logo.png" alt="ICT Mates" width="1000" height="333" loading="lazy" /></a><p>Technology for your next chapter.</p><nav aria-label="Footer navigation"><a href="/why-wrenio/">Compare webshops</a><a href="/#pricing">Webshop plans</a><a href="/#services">Services</a><a href="/partners/">Partners</a><a href="/contact/" aria-current="page">Contact</a></nav><div class="footer-bottom"><span>© {new Date().getFullYear()} ICT Mates. All rights reserved.</span><span>Webstore.pk · A service by ICT Mates</span></div></footer>
    <script>
      import { setupEnquiryEmail } from '../scripts/enquiry-email';

      const form = document.querySelector<HTMLFormElement>('#contact-enquiry');
      const send = document.querySelector<HTMLButtonElement>('#send-email');
      const status = document.querySelector<HTMLElement>('#email-status');
      if (form && send && status) {
        const deliverEmail = setupEnquiryEmail(form, send, status);
        form.addEventListener('submit', async event => {
          event.preventDefault();
          const values = new FormData(form);
          if (!String(values.get('name')).trim() || !String(values.get('message')).trim()) {
            status.textContent = 'Please enter your name and a message.';
            return;
          }
          await deliverEmail();
        });
      }
    </script>
    <script src="../scripts/active-navigation.ts"></script>
  </body>
</html>
<style>
  .contact-page { padding-block:28px 12px; }
  .contact { align-items:start; grid-template-columns:1fr 1.15fr; }
  .contact h1 { font-size:clamp(38px,4.6vw,64px); }
  .enquiry-panel h2 { font-size:26px; margin-bottom:10px; }
  .direct-contact { display:grid; justify-items:start; gap:16px; margin-top:30px; }
  .direct-contact .text-link { color:#fff; }
  .enquiry-actions { margin-top:16px; }
  @media(max-width:900px) { .contact { grid-template-columns:1fr; } }
</style>
