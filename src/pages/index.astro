---
import '../styles/global.css';
const features = [
  ['store', 'Your brand. Your own store.', 'Start with your own webstore.pk address or connect a custom domain. Give your products a dedicated home, with hosting and support included.'],
  ['sliders', 'Tools for your day-to-day', 'Manage products and orders in your own admin panel. Built-in AI assistance helps you draft product content to review and refine.'],
  ['headset', 'A local team behind you', 'Pay your subscription in Pakistani rupees and talk to the ICT Mates team in Lahore. We help you get started and keep your webshop running.'],
];
const faqs = [
  ['What does ICT Mates do?', 'We’re an IT company in Lahore, Pakistan, offering web and mobile development, UI / UX design, digital marketing and custom software development. Our core product is Webstore.pk, a managed webshop service for businesses in Pakistan.'],
  ['What is Webstore.pk?', 'Webstore.pk is our managed webshop service. It gives your business its own online store, a webstore.pk address, hosting, local support and an admin panel for products and orders. It is powered by Wrenio Commerce, the e-commerce software built by Wrenio Studio.'],
  ['What is included in a Webstore.pk subscription?', 'Your managed webshop, a webstore.pk subdomain, hosting, local support and product and order administration, with built-in AI content assistance and SEO and GEO optimization. Custom domains and third-party service charges are separate.'],
  ['Do I need my own domain?', 'No. A webstore.pk subdomain is included. You can also bring an existing domain or ask us to arrange one. Custom domain registration costs Rs. 4,200 for two years, separate from your subscription.'],
  ['Can I see the webshop before deciding?', 'Yes. Visit Webstore.pk to explore the service, or ask ICT Mates for a walkthrough of a dedicated webshop and its product and order management tools.'],
  ['Can you help with a project beyond e-commerce?', 'Yes. Talk to us about a website, mobile app, design, marketing or custom software project. We’ll discuss your requirements, scope and costs before you decide.'],
  ['Can you help me move an existing store?', 'Tell us about your current store, products and requirements. We’ll review the migration scope and discuss any additional cost before you decide.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/dm-sans-latin-v17.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-v23.woff2" as="font" type="font/woff2" crossorigin />
    <title>ICT Mates | Technology for your business. Home of Webstore.pk.</title>
    <meta name="description" content="ICT Mates is your technology partner in Lahore, Pakistan. Discover Webstore.pk, our core webshop service, alongside development, design, marketing and custom software." />
    <link rel="canonical" href="https://ictmates.com/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#0b1169" />
    <meta property="og:title" content="Your business. Our expertise. | ICT Mates" />
    <meta property="og:description" content="Meet ICT Mates, the team behind Webstore.pk. Managed webshops, web and mobile development, design, digital marketing and custom software from Lahore." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ictmates.com/" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="announcement">Your technology partner in Pakistan <span>·</span> Home of Webstore.pk <a href="https://webstore.pk/" target="_blank" rel="noopener noreferrer">Explore our core product ↗︎</a></div>
    <header class="site-header">
      <div class="header wrap">
        <a class="logo" href="#" aria-label="ICT Mates home"><img src="/ictmates-logo.png" alt="ICT Mates" width="1000" height="333" /></a>
        <button class="menu-toggle" type="button" aria-controls="header-menu" aria-expanded="false">Menu</button>
        <div class="header-menu" id="header-menu">
          <nav aria-label="Main navigation">
            <a href="#features">Webstore.pk</a><a href="#services">Services</a><a href="#pricing">Webshop plans</a><a href="/partners/">Partners</a><a href="#about">About us</a>
          </nav>
          <a class="button small" href="/contact/">Let’s talk <span aria-hidden="true">↗︎</span></a>
        </div>
      </div>
    </header>
    <main id="main">
      <section class="hero wrap" id="webshops">
        <div class="hero-copy">
          <div class="eyebrow"><span class="status-dot"></span> ICT MATES · YOUR TECHNOLOGY PARTNER</div>
          <h1>Your business.<br />Our expertise.<br /><em>Built to grow.</em></h1>
          <p class="intro">We help businesses build, design and grow online. At the heart of ICT Mates is Webstore.pk—our managed webshop service, backed by a local team in Lahore.</p>
          <div class="hero-price"><strong>Webstore.pk</strong><span>by ICT Mates</span></div>
          <p class="price-note">Your own webshop from Rs. 3,000/month. Hosting & support included.</p>
          <div class="actions"><a class="button" href="https://webstore.pk/" target="_blank" rel="noopener noreferrer">Explore Webstore.pk <span aria-hidden="true">↗︎</span></a><a class="text-link" href="#services">Our services <span aria-hidden="true">↓</span></a></div>
          <div class="hero-checks"><span>✓ Your own brand</span><span>✓ Managed hosting</span><span>✓ Local support</span></div>
          <p class="fine-print">Custom domains and third-party service charges are separate.</p>
        </div>
        <div class="hero-art" aria-label="Illustration of a dedicated webshop and product management panel">
          <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
          <div class="art-label">A LITTLE IDEA. A WORLD OF POSSIBILITIES.</div>
          <div class="store-window">
            <div class="browser-bar"><span class="browser-dots">● ● ●</span><span class="address">⌑ &nbsp; yourbrand.webstore.pk</span><span>↗︎</span></div>
            <div class="store-nav"><strong>everyday<span>®</span></strong><span>Shop &nbsp; About &nbsp; <span aria-hidden="true">▢</span></span></div>
            <div class="store-hero"><span>THOUGHTFULLY CHOSEN.</span><h2>Small things.<br />Everyday joy.</h2><span class="mock-button">Discover the collection ↗︎</span><div class="vase"><i></i></div><div class="sun-circle"></div></div>
            <div class="store-section-title"><strong>Your next favourite</strong><span>Shop all ↗︎</span></div>
            <div class="mock-products"><div><div class="product-art peach"><div class="mug"></div></div><strong>The everyday mug</strong><span>Rs. 1,200</span></div><div><div class="product-art sage"><div class="tote"></div></div><strong>The go-anywhere tote</strong><span>Rs. 1,800</span></div><div><div class="product-art lavender"><div class="bottle"></div></div><strong>The daily bottle</strong><span>Rs. 1,500</span></div></div>
            <div class="powered">Powered by <strong>Wrenio Commerce</strong></div>
          </div>
          <div class="admin-card"><span class="admin-icon" aria-hidden="true">▦</span><div><strong>Your shop. Your dashboard.</strong><span>Products & orders, in your hands.</span></div><span class="check-circle">✓</span></div>
          <div class="hosting-badge"><span aria-hidden="true">✳︎</span><strong>Hosting<br />included.</strong></div>
          <p class="illustration-note">Illustrative storefront · Your shop, your identity</p>
        </div>
      </section>
      <div class="proof-strip">
        <div class="wrap proof-inner">
          <a class="proof-item proof-link" href="https://action.pk" target="_blank" rel="noopener noreferrer"><span>Our retail experience</span><strong>action.pk <span aria-hidden="true">↗︎</span></strong></a>
          <p class="proof-item"><span>Our expertise</span><strong>Development & design</strong></p>
          <a class="proof-item proof-link" href="https://webstore.pk" target="_blank" rel="noopener noreferrer"><span>Our core product</span><strong>Webstore.pk <span aria-hidden="true">↗︎</span></strong></a>
          <p class="proof-item"><span>Based in</span><strong>Lahore, Pakistan</strong></p>
        </div>
      </div>
      <section class="section wrap" id="features">
        <div class="section-heading"><div><div class="eyebrow">OUR CORE PRODUCT · WEBSTORE.PK</div><h2>Your business.<br /><em>Your own webshop.</em></h2></div><p>Webstore.pk brings your online store, hosting and local support together. A managed service from ICT Mates, with clear pricing in rupees and tools to help you sell.</p></div>
        <div class="feature-grid">{features.map(([icon,title,description])=><article class="feature-card"><span class="feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href={`/feature-icons.svg#${icon}`} /></svg></span><h3>{title}</h3><p>{description}</p></article>)}</div>
      </section>
      <section class="demo-section wrap" id="demo"><div class="demo-copy"><div class="eyebrow">WEBSTORE.PK BY ICT MATES</div><h2>A store of your own.<br />A team on your side.</h2><p>Your brand, your products, your own place to sell. Webstore.pk combines a managed webshop with hosting, built-in AI content assistance and local support from ICT Mates.</p><p>Your store is powered by <a class="text-link" href="https://wreniocommerce.com/" target="_blank" rel="noopener noreferrer">Wrenio Commerce</a>, the e-commerce software built by <a class="text-link" href="https://wrenio.studio/" target="_blank" rel="noopener noreferrer">Wrenio Studio</a>. We provide the service and support to help you get started and run your shop.</p><a class="button light" href="https://webstore.pk/" target="_blank" rel="noopener noreferrer">Discover Webstore.pk ↗︎</a><p class="demo-note">Explore the service and ask our team for a walkthrough.</p></div><div class="platform-card"><img class="platform-symbol" src="/wren-white.webp" alt="Wrenio Commerce" width="68" height="68" loading="lazy" /><span class="eyebrow">POWERED BY WRENIO COMMERCE</span><h3>Your brand.<br />Your space to grow.</h3><ul><li><span>01</span> Your own webshop & store address</li><li><span>02</span> Product & order management</li><li><span>03</span> Built-in AI content assistance</li><li><span>04</span> Hosting & local support</li></ul></div></section>
      <section class="section wrap" id="services"><div class="section-heading"><div><div class="eyebrow">MORE FROM ICT MATES</div><h2>The expertise<br /><em>behind your next idea.</em></h2></div><p>From a first website to software shaped around your business, our team brings development, design and marketing together. Tell us what you want to build.</p></div><div class="services-grid">{[['Web & mobile development','Bring your ideas to the web and mobile.'],['UI / UX design','Make your digital products clearer and easier to use.'],['Digital marketing','Help the right people discover your business.'],['Custom Software Development','Software tailored to your business, workflows, and goals.']].map(([title,copy])=><a class="service" href="#contact" data-service={title}><h3>{title}<span aria-hidden="true">↗︎</span></h3><p>{copy}</p></a>)}</div></section>
      <section class="section wrap" id="pricing"><div class="center-heading"><div class="eyebrow">WEBSTORE.PK SUBSCRIPTIONS</div><h2>A real shop.<br /><em>A straightforward price.</em></h2><p>Choose how you pay for Webstore.pk. Your managed webshop, store subdomain, hosting and local support are included in both plans.</p></div><div class="pricing-grid"><article class="plan"><span class="eyebrow">KEEP IT MONTHLY</span><h3>Monthly</h3><div class="plan-price"><span>Rs.</span> 3,000 <small>/ month</small></div><p>A simple monthly subscription for your shop.</p><ul><li>Dedicated webshop & store subdomain</li><li>Hosting and support</li><li>Product & order admin with built-in AI help</li><li>SEO & GEO optimized storefront</li><li>No marketplace sales commission</li></ul><a class="button outline" href="#contact" data-plan="monthly">Choose monthly ↗︎</a></article><article class="plan featured"><span class="plan-tag">TWO MONTHS FREE</span><span class="eyebrow">MAKE IT A YEAR</span><h3>Annual</h3><div class="plan-price"><span>Rs.</span> 30,000 <small>/ year</small></div><p>Equivalent to Rs. 2,500/month, billed annually.</p><ul><li>Everything in the monthly plan</li><li>Save Rs. 6,000 over 12 monthly payments</li><li>Hosting and support all year</li><li>No marketplace sales commission</li></ul><a class="button" href="#contact" data-plan="annual">Choose annual ↗︎</a></article></div><div class="domain-note"><span aria-hidden="true">◎</span><div><strong>Your store address is included.</strong><p>Your webstore.pk subdomain is included. Custom domain registration is separate: <strong>Rs. 4,200 for two years.</strong> We can arrange it, you can buy through a PKNIC reseller, or bring a domain you already own.</p></div></div><p class="pricing-footnote">Subscription pricing is for your dedicated webshop. Payment-provider, delivery and other third-party services may have separate charges; discuss your requirements with us.</p></section>
      <section class="marketplace wrap"><div><div class="eyebrow">ANOTHER WAY TO SELL</div><h2>Prefer to join a marketplace?</h2><p>Sell alongside other businesses on action.pk with your own seller page. Marketplace sales carry a <strong>20% commission</strong>. This is separate from the dedicated webshop subscription.</p></div><a class="text-link" href="https://action.pk" target="_blank" rel="noopener noreferrer">Explore action.pk ↗︎</a></section>
      <section class="about wrap" id="about"><div class="eyebrow">HELLO. WE’RE ICT MATES.</div><h2>Your next chapter.<br /><em>Our team, by your side.</em></h2><div><p>We’re an IT company based in Lahore, Pakistan. We bring together development, design, digital marketing and experience in online retail to help businesses take their next step.</p><p>Webstore.pk is our core product: a managed webshop service powered by Wrenio Commerce. Alongside it, we work with businesses on websites, apps and custom software, and operate the action.pk marketplace.</p><span class="location">↗︎ Gulberg III, Lahore · Pakistan</span></div></section>
      <section class="section wrap faq" id="faq"><div><div class="eyebrow">A FEW THINGS YOU MIGHT ASK</div><h2>Let’s make<br /><em>it clear.</em></h2><p>Something else on your mind?<br /><a href="#contact" class="text-link">Talk to our team ↗︎</a></p></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
      <section class="contact wrap" id="contact"><div><div class="eyebrow">LET’S TALK ABOUT YOUR BUSINESS</div><h2>Your next chapter<br />starts with a conversation.</h2><p>Start with a Webstore.pk webshop, or talk to us about development, design, marketing or custom software. Tell us what you have in mind.</p></div><div class="contact-actions"><a class="button lime" id="contact-whatsapp" href="https://wa.me/923005551575" target="_blank" rel="noopener noreferrer">Chat with us on WhatsApp ↗︎</a><a class="contact-number" href="https://wa.me/923005551575" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp at +92 300 555 1575">+92 300 555 1575</a><p id="plan-interest" aria-live="polite">Tell us about your project, ask a question, or discuss any of our services.</p><p><a class="text-link" href="/contact/">Send us an email enquiry ↗︎</a></p><span>Building 13, Block J, Gulberg III<br />Lahore, Pakistan</span></div></section>
    </main>
    <footer class="wrap footer"><a class="logo" href="#"><img src="/ictmates-logo.png" alt="ICT Mates" width="1000" height="333" loading="lazy" /></a><p>Technology for your next chapter.</p><nav aria-label="Footer navigation"><a href="/why-wrenio/">Compare webshops</a><a href="#pricing">Webshop plans</a><a href="#services">Services</a><a href="/partners/">Partners</a><a href="#faq">FAQs</a><a href="/contact/">Contact</a></nav><div class="footer-bottom"><span>© {new Date().getFullYear()} ICT Mates. All rights reserved.</span><span>Webstore.pk · A service by ICT Mates</span></div></footer>
    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-plan]').forEach(link => {
        link.addEventListener('click', () => {
          const text = document.querySelector('#plan-interest');
          const annual = link.dataset.plan === 'annual';
          const plan = annual ? 'Rs. 30,000/year' : 'Rs. 3,000/month';
          if (text) text.textContent = `Message us on WhatsApp about the Webstore.pk ${plan} plan.`;
          const whatsapp = document.querySelector<HTMLAnchorElement>('#contact-whatsapp');
          if (whatsapp) whatsapp.href = `https://wa.me/923005551575?text=${encodeURIComponent(`Hello ICT Mates, I’m interested in the Webstore.pk ${plan} plan.`)}`;
        });
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach(link => {
        link.addEventListener('click', () => {
          const service = link.dataset.service;
          const text = document.querySelector('#plan-interest');
          if (text) text.textContent = `Talk to us about ${service}. We’ll discuss your requirements and next steps.`;
          const whatsapp = document.querySelector<HTMLAnchorElement>('#contact-whatsapp');
          if (whatsapp) whatsapp.href = `https://wa.me/923005551575?text=${encodeURIComponent(`Hello ICT Mates, I’d like to discuss ${service}.`)}`;
        });
      });
    </script>
    <script src="../scripts/active-navigation.ts"></script>
  </body>
</html>
