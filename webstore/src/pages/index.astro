---
import GoogleTagManager from '../components/GoogleTagManager.astro';
import SocialShareMeta from '../components/SocialShareMeta.astro';
import '../styles/global.css';
import '../styles/webstore.css';
const turnstileKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '').trim();
const features = [
  ['store', 'Your store. Built to be found.', 'Your brand and your own storefront, optimized for search engines (SEO) and AI discovery (GEO). Start with a webstore.pk address or connect your own domain.'],
  ['sliders', 'AI help, in your admin', 'Generate product titles, descriptions, short descriptions and image alt text with built-in AI assistance. Review and refine the drafts while managing your products and orders.'],
  ['headset', 'Managed here. Supported locally.', 'Pay your subscription locally in Pakistani rupees, with hosting and support together. The ICT Mates team in Lahore is here to help you run your store.'],
];
const faqs = [
  ['Why choose Webstore.pk instead of Shopify or WooCommerce?', 'Webstore.pk offers a cost-effective managed option for businesses that want hosting, built-in AI help and local support together, with clear pricing in rupees and local subscription payments. Compare the complete cost of the setup you need, including apps or plugins, maintenance and technical help. Costs vary by requirements; a self-managed WooCommerce store can cost less.'],
  ['What can the built-in AI help me write?', 'Inside your store admin, AI can help generate product titles, full descriptions, short descriptions and image alt text. Use it to prepare drafts, then check product facts and image descriptions and refine the wording before publishing.'],
  ['What do SEO and GEO optimization mean for my store?', 'SEO means search engine optimization. GEO means generative engine optimization: preparing content for discovery and understanding by AI-powered search and answer tools. Your webshop is optimized with both in mind. Useful, accurate product content remains important; search rankings and inclusion in AI answers are not guaranteed.'],
  ['What is included in my subscription?', 'Your managed webshop, a webstore.pk subdomain, hosting, local support and an admin panel for products and orders, with built-in AI content assistance and SEO and GEO optimization. A custom domain is separate.'],
  ['Do I need my own domain to get started?', 'No. Start with an address such as yourname.webstore.pk. You can connect your own domain when you are ready, or bring one you already own.'],
  ['How much does a custom domain cost?', 'The current domain-registration offer is Rs. 4,200 for two years, separate from your subscription. ICT Mates can arrange registration, or you can buy through a PKNIC reseller. Contact us to check your preferred domain.'],
  ['Do you charge a commission on my sales?', 'There is no marketplace sales commission on your dedicated webshop. Payment-provider, delivery and other third-party charges may still apply. Discuss your requirements with us before choosing your setup.'],
  ['Who provides Webstore.pk?', 'Webstore.pk is a service by ICT Mates, based in Lahore. Your store is powered by Wrenio Commerce, the e-commerce software built by Wrenio Studio. ICT Mates provides the service and support.'],
  ['Can I see the store and admin panel before deciding?', 'Yes. Ask ICT Mates for a walkthrough of a dedicated webshop and its product and order management tools. We will help you understand the setup before you choose a plan.'],
  ['Is this a marketplace seller page?', 'No. This offer is for a standalone webshop with your own brand. Selling on the action.pk marketplace is a separate option with a 20% sales commission.'],
  ['Can you help me move an existing store?', 'Tell us about your current store, products and requirements. We will review the migration scope and discuss any additional cost before you decide.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/dm-sans-latin-v17.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-v23.woff2" as="font" type="font/woff2" crossorigin />
    <title>Your business. Your online store. | Webstore.pk</title>
    <meta name="description" content="A managed online store in Pakistan from Rs. 3,000/month, with built-in AI help, SEO and GEO optimization, hosting and local support from ICT Mates." />
    <link rel="canonical" href="https://webstore.pk/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#0b1169" />
    <meta property="og:title" content="Your business. Your online store. | Webstore.pk" />
    <meta property="og:description" content="A managed webshop for Pakistan with built-in AI help, SEO and GEO optimization, hosting and local support. From Rs. 3,000/month. Powered by Wrenio Commerce." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://webstore.pk/" />
    <SocialShareMeta />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="announcement">Made for businesses in Pakistan <span>·</span> Pay yearly and get two months free <a href="#pricing">See plans ↗︎</a></div>
    <header class="site-header">
      <div class="header wrap">
        <a class="logo" href="#" aria-label="Webstore.pk home"><img src="/webstore-logo.webp" alt="Webstore.pk" width="600" height="132" /></a>
        <button class="menu-toggle" type="button" aria-controls="header-menu" aria-expanded="false">Menu</button>
        <div class="header-menu" id="header-menu">
          <nav aria-label="Main navigation">
            <a href="#features">Your store</a><a href="#how-it-works">How it works</a><a href="#pricing">Pricing</a><a href="/partners/">Partners</a><a href="/login/">Store login</a>
          </nav>
          <a class="button small" href="#contact">Get started <span aria-hidden="true">↗︎</span></a>
        </div>
      </div>
    </header>
    <main id="main">
      <section class="hero wrap" id="webshops">
        <div class="hero-copy">
          <div class="eyebrow"><span class="status-dot"></span> WEBSTORE.PK BY ICT MATES</div>
          <h1>Your business.<br />Your <em>online<br />store.</em></h1>
          <p class="hero-urdu" lang="ur" dir="rtl"><img src="/app-ka-apna.webp" alt="آپ کا کاروبار — آپ کا اپنا آن لائن سٹور" width="1000" height="300" /></p>
          <p class="intro">Give your business a place of its own. A managed webshop with built-in AI help, hosting and local support—a straightforward, cost-effective way to start selling online.</p>
          <div class="hero-price"><strong>Rs. 3,000</strong><span>/ month</span></div>
          <p class="price-note">Hosting, support & a store subdomain included.</p>
          <div class="actions"><a class="button" href="#contact">Get my online store <span aria-hidden="true">↗︎</span></a><a class="text-link" href="#how-it-works">How it works <span aria-hidden="true">↓</span></a></div>
          <div class="hero-checks"><span>✓ Your own brand</span><span>✓ Your own admin panel</span><span>✓ No marketplace commission</span></div>
          <p class="fine-print">Custom domain and third-party service charges are separate.</p>
        </div>
        <div class="hero-art" aria-label="Illustration of a dedicated webshop and product management panel">
          <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
          <div class="art-label">YOUR BRAND. YOUR SPACE TO GROW.</div>
          <div class="store-window">
            <div class="browser-bar"><span class="browser-dots">● ● ●</span><span class="address">⌑ &nbsp; yourbrand.webstore.pk</span><span>↗︎</span></div>
            <div class="store-nav"><strong>everyday<span>®</span></strong><span>Shop &nbsp; About &nbsp; <span aria-hidden="true">▢</span></span></div>
            <div class="store-hero"><span>THOUGHTFULLY CHOSEN.</span><h2>Small things.<br />Everyday joy.</h2><span class="mock-button">Discover the collection ↗︎</span><div class="vase"><i></i></div><div class="sun-circle"></div></div>
            <div class="store-section-title"><strong>Your next favourite</strong><span>Shop all ↗︎</span></div>
            <div class="mock-products"><div><div class="product-art peach"><div class="mug"></div></div><strong>The everyday mug</strong><span>Rs. 1,200</span></div><div><div class="product-art sage"><div class="tote"></div></div><strong>The go-anywhere tote</strong><span>Rs. 1,800</span></div><div><div class="product-art lavender"><div class="bottle"></div></div><strong>The daily bottle</strong><span>Rs. 1,500</span></div></div>
            <div class="powered">Powered by <strong>Wrenio Commerce</strong></div>
          </div>
          <div class="admin-card"><span class="admin-icon" aria-hidden="true">▦</span><div><strong>Your shop. Your dashboard.</strong><span>Products & orders, in your hands.</span></div><span class="check-circle">✓</span></div>
          <div class="hosting-badge"><span aria-hidden="true">✳︎</span><strong>Hosting<br />included.</strong></div>
          <p class="illustration-note">Illustrative storefront · Your shop, your identity</p>
        </div>
      </section>
      <div class="proof-strip"><div class="wrap proof-inner">
        <p class="proof-item"><span>Your own address</span><strong>yourname.webstore.pk</strong></p>
        <p class="proof-item"><span>Simple subscriptions</span><strong>Priced in Pakistani rupees</strong></p>
        <a class="proof-item proof-link" href="https://wreniocommerce.com/" target="_blank" rel="noopener noreferrer"><span>Powered by</span><strong>Wrenio Commerce ↗︎</strong></a>
        <a class="proof-item proof-link" href="https://ictmates.com/" target="_blank" rel="noopener noreferrer"><span>A service by</span><strong>ICT Mates, Lahore ↗︎</strong></a>
      </div></div>
      <section class="section wrap" id="features">
        <div class="section-heading"><div><div class="eyebrow">A STORE THAT BELONGS TO YOUR BUSINESS</div><h2>Your name above the door.<br /><em>Your business inside.</em></h2></div><p>An easy alternative to Shopify, WooCommerce and other e-commerce solutions. Get predictable pricing in rupees, local subscription payments, built-in AI assistance and local support in one managed service.</p></div>
        <div class="feature-grid">{features.map(([icon,title,description])=><article class="feature-card"><span class="feature-icon"><svg class="info-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href={`/info-icons.svg#${icon}`} /></svg></span><h3>{title}</h3><p>{description}</p></article>)}</div>
      </section>
      <section class="demo-section wrap" id="your-address">
        <div class="demo-copy"><div class="eyebrow">START HERE. MAKE IT YOURS.</div><h2>An address today.<br />Your own domain<br />when you’re ready.</h2><p>You don’t need to buy a domain before getting started. Your store comes with a webstore.pk address, so you can take the first step with your own branded shop.</p><p>Already have a domain? Bring it along. Want one later? ICT Mates can help you arrange it.</p><a class="button light" href="#contact">Let’s talk about your store ↗︎</a></div>
        <div class="address-card"><span class="eyebrow">ONE STORE. ROOM TO GROW.</span><div class="domain-stage"><span class="step-label"><svg class="info-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/info-icons.svg#globe" /></svg> START WITH YOUR STORE ADDRESS</span><strong>yourname<span>.webstore.pk</span></strong><p>A subdomain included with your subscription.</p></div><span class="domain-arrow" aria-hidden="true">↓</span><div class="domain-stage"><span class="step-label"><svg class="info-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/info-icons.svg#link" /></svg> CONNECT YOUR OWN DOMAIN</span><strong>yourbrand<span>.pk</span></strong><p>Your brand at your own address. Domain registration is separate.</p></div><p class="address-caption">Example addresses, for illustration.</p></div>
      </section>
      <section class="section wrap" id="how-it-works"><div class="section-heading"><div><div class="eyebrow">FROM AN IDEA TO YOUR OWN STORE</div><h2>Let’s get your<br /><em>business online.</em></h2></div><p>Start with a conversation. We’ll discuss what your business needs and guide you through the next steps.</p></div><ol class="steps"><li><span><svg class="info-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/info-icons.svg#message" /></svg></span><h3>Tell us about your business</h3><p>Share what you sell, ask for a walkthrough, and choose the subscription that suits you.</p></li><li><span><svg class="info-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/info-icons.svg#sliders" /></svg></span><h3>Make the store yours</h3><p>Work with our team on your store setup, products and address. Start with a subdomain or bring your own domain.</p></li><li><span><svg class="info-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/info-icons.svg#box" /></svg></span><h3>Manage your day-to-day</h3><p>Use your admin panel to manage products and orders, with ICT Mates on hand for support.</p></li></ol></section>
      <section class="section wrap" id="pricing"><div class="center-heading"><div class="eyebrow">SMALL PRICE. BIG POSSIBILITIES.</div><h2>A real shop.<br /><em>A straightforward price.</em></h2><p>Choose how you pay. Both plans include your managed webshop, hosting, local support, built-in AI assistance and SEO and GEO optimization.</p></div><div class="pricing-grid"><article class="plan"><span class="eyebrow">KEEP IT MONTHLY</span><h3>Monthly</h3><div class="plan-price"><span>Rs.</span> 3,000 <small>/ month</small></div><p>A simple monthly subscription for your shop.</p><ul><li>Dedicated webshop & store subdomain</li><li>Hosting and support</li><li>Product & order admin with built-in AI help</li><li>SEO & GEO optimized storefront</li><li>No marketplace sales commission</li></ul><a class="button outline" href="#contact" data-plan="monthly">Choose monthly ↗︎</a></article><article class="plan featured"><span class="plan-tag">TWO MONTHS FREE</span><span class="eyebrow">MAKE IT A YEAR</span><h3>Annual</h3><div class="plan-price"><span>Rs.</span> 30,000 <small>/ year</small></div><p>Equivalent to Rs. 2,500/month, billed annually.</p><ul><li>Everything in the monthly plan</li><li>Save Rs. 6,000 over 12 monthly payments</li><li>Hosting and local support all year</li><li>Built-in AI help, SEO & GEO optimization</li><li>No marketplace sales commission</li></ul><a class="button" href="#contact" data-plan="annual">Choose annual ↗︎</a></article></div><div class="domain-note"><span aria-hidden="true">◎</span><div><strong>Your custom domain, when you’re ready.</strong><p>Your webstore.pk subdomain is included. Custom domain registration is separate: <strong>Rs. 4,200 for two years.</strong> We can arrange it, you can buy through a PKNIC reseller, or bring a domain you already own.</p></div></div><p class="pricing-footnote">Subscription pricing is for your dedicated webshop. Payment-provider, delivery and other third-party services may have separate charges; discuss your requirements with us.</p></section>
      <section class="about wrap" id="about"><div class="eyebrow">A LOCAL TEAM BEHIND YOUR ONLINE STORE</div><h2>Webstore.pk<br /><em>By ICT Mates.</em></h2><div><p>Webstore.pk brings you a dedicated webshop powered by <a class="text-link" href="https://wreniocommerce.com/" target="_blank" rel="noopener noreferrer">Wrenio Commerce</a>, the e-commerce software built by <a class="text-link" href="https://wrenio.studio/" target="_blank" rel="noopener noreferrer">Wrenio Studio</a>.</p><p>ICT Mates is based in Lahore. We bring our experience in development, design and online retail to your business. You have a team to talk to, from your first questions to running your store.</p><a class="text-link" href="https://ictmates.com/" target="_blank" rel="noopener noreferrer">Meet ICT Mates ↗︎</a></div></section>
      <section class="section wrap faq" id="faq"><div><div class="eyebrow">A FEW THINGS YOU MIGHT ASK</div><h2>Let’s make<br /><em>it clear.</em></h2><p>Something else on your mind?<br /><a href="#contact" class="text-link">Talk to our team ↗︎</a></p></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
      <section class="contact wrap" id="contact">
        <div><div class="eyebrow">LET’S GET YOUR BUSINESS ONLINE</div><h2>Your shop’s next<br />chapter starts here.</h2><p>Tell us what you sell and what you have in mind. Send an email enquiry or prepare a WhatsApp message, and we’ll show you how Webstore.pk can work for your business.</p><div class="store-direct"><p>Prefer a conversation? Call or WhatsApp ICT Mates.</p><a class="store-phone" href="tel:+923005551575">+92 300 555 1575</a><a class="text-link" id="contact-whatsapp" href="https://wa.me/923005551575" target="_blank" rel="noopener noreferrer">Chat with us on WhatsApp ↗︎</a><p>Building 13, Block J, Gulberg III<br />Lahore, Pakistan</p></div></div>
        <div class="store-form-panel">
          <form id="store-enquiry" aria-labelledby="store-enquiry-title" data-captcha-key={turnstileKey} data-enquiry-kind="store">
            <div class="botcheck" aria-hidden="true"><label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
            <h3 id="store-enquiry-title">Tell us about your store</h3>
            <p class="form-intro"><span class="required-mark" aria-hidden="true">*</span> Required fields. Choose email or WhatsApp below.</p>
            <div class="form-fields">
              <div class="form-field"><label for="store-name">Your name <span class="required-mark" aria-hidden="true">*</span></label><input id="store-name" name="name" type="text" autocomplete="name" maxlength="100" required /></div>
              <div class="form-field"><label for="store-business">Business name <span class="required-mark" aria-hidden="true">*</span></label><input id="store-business" name="business" type="text" autocomplete="organization" maxlength="120" required /></div>
              <div class="contact-fields">
                <div class="form-field"><label for="store-email">Email <span class="optional-label">(optional)</span></label><input id="store-email" name="email" type="email" autocomplete="email" maxlength="254" /></div>
                <div class="form-field"><label for="store-phone">Phone number <span class="required-mark" aria-hidden="true">*</span></label><input id="store-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" required /></div>
              </div>
              <div class="contact-fields">
                <div class="form-field"><label for="store-city">City <span class="required-mark" aria-hidden="true">*</span></label><input id="store-city" name="city" type="text" autocomplete="address-level2" maxlength="80" required /></div>
                <div class="form-field"><label for="store-plan">Plan preference</label><select id="store-plan" name="plan"><option value="undecided">Help me choose</option><option value="monthly">Monthly — Rs. 3,000</option><option value="annual">Annual — Rs. 30,000</option></select></div>
              </div>
              <div class="form-field"><label for="store-message">What do you have in mind? <span class="optional-label">(optional)</span></label><textarea id="store-message" name="message" rows="3" maxlength="2000" placeholder="What you sell, a walkthrough, or help with an existing store…"></textarea></div>
            </div>
            <p id="plan-interest" class="form-status" aria-live="polite">Ask for a walkthrough or tell us about your store.</p>
            <div data-captcha></div><p class="form-status" data-captcha-status aria-live="polite"></p>
            <div class="enquiry-actions"><button class="button" type="submit" id="send-store-email" disabled aria-describedby="store-email-status">Send enquiry by email ↗︎</button><button class="button outline" type="submit" id="prepare-store-enquiry" disabled>Prepare WhatsApp message ↓</button></div>
            <p id="store-email-status" class="form-status" role="status">{turnstileKey ? 'Send your enquiry securely by email, or choose WhatsApp.' : 'Local preview: email delivery awaits connection. You can still use WhatsApp.'}</p>
            <noscript><p>Enable JavaScript to send your enquiry, or <a href="https://wa.me/923005551575" target="_blank" rel="noopener noreferrer">contact ICT Mates on WhatsApp</a>.</p></noscript>
          </form>
          <div id="store-enquiry-preview" class="enquiry-preview" hidden><h4>Your WhatsApp message</h4><p id="store-enquiry-message"></p><a class="button" id="store-whatsapp" target="_blank" rel="noopener noreferrer">Open WhatsApp ↗︎</a><p class="send-note">Preparing this message does not send it. Opening WhatsApp shares these details with WhatsApp; you choose when to send it to ICT Mates.</p></div>
        </div>
      </section>
    </main>
    <footer class="wrap footer"><a class="logo" href="#"><img src="/webstore-logo.webp" alt="Webstore.pk" width="600" height="132" loading="lazy" /></a><p>Your business. Your online store.</p><nav aria-label="Footer navigation"><a href="#pricing">Pricing</a><a href="#faq">FAQs</a><a href="/partners/">Partners</a><a href="/login/">Store login</a><a href="#contact">Contact</a></nav><div class="footer-bottom"><span>© {new Date().getFullYear()} Webstore.pk · A service by ICT Mates.</span><span>Powered by <a href="https://wreniocommerce.com/" target="_blank" rel="noopener noreferrer">Wrenio Commerce</a> · Built by <a href="https://wrenio.studio/" target="_blank" rel="noopener noreferrer">Wrenio Studio</a></span></div></footer>
    <script>
      import { setupEnquiryEmail } from '../scripts/enquiry-email';
      const form = document.querySelector<HTMLFormElement>('#store-enquiry');
      const plan = document.querySelector<HTMLSelectElement>('#store-plan');
      const status = document.querySelector<HTMLParagraphElement>('#plan-interest');
      const emailStatus = document.querySelector<HTMLParagraphElement>('#store-email-status');
      const sendEmail = document.querySelector<HTMLButtonElement>('#send-store-email');
      const prepare = document.querySelector<HTMLButtonElement>('#prepare-store-enquiry');
      const preview = document.querySelector<HTMLDivElement>('#store-enquiry-preview');
      const messageText = document.querySelector<HTMLParagraphElement>('#store-enquiry-message');
      const whatsapp = document.querySelector<HTMLAnchorElement>('#store-whatsapp');
      const directWhatsapp = document.querySelector<HTMLAnchorElement>('#contact-whatsapp');
      if (form && plan && status && emailStatus && sendEmail && prepare && preview && messageText && whatsapp) {
        const deliverEmail = setupEnquiryEmail(form, sendEmail, emailStatus);
        const planLabels: Record<string, string> = { undecided: 'Help me choose', monthly: 'Monthly — Rs. 3,000/month', annual: 'Annual — Rs. 30,000/year' };
        prepare.disabled = false;
        const invalidateMessage = () => {
          const wasPrepared = !preview.hidden;
          preview.hidden = true;
          whatsapp.removeAttribute('href');
          status.textContent = wasPrepared ? 'Details changed. Prepare your WhatsApp message again to include the updates.' : `Plan preference: ${planLabels[plan.value]}.`;
          if (directWhatsapp) directWhatsapp.href = `https://wa.me/923005551575?text=${encodeURIComponent(`Hello ICT Mates, I’m interested in a Webstore.pk webshop. Plan preference: ${planLabels[plan.value]}.`)}`;
        };
        form.addEventListener('input', event => {
          if (event.target instanceof HTMLInputElement) event.target.setCustomValidity('');
          invalidateMessage();
        });
        document.querySelectorAll<HTMLAnchorElement>('[data-plan]').forEach(link => {
          link.addEventListener('click', () => {
            const selected = link.dataset.plan;
            if (selected !== 'monthly' && selected !== 'annual') return;
            plan.value = selected;
            invalidateMessage();
            form.querySelector<HTMLInputElement>('#store-name')?.focus({ preventScroll:true });
          });
        });
        form.addEventListener('submit', async event => {
          event.preventDefault();
          form.querySelectorAll<HTMLInputElement>('input[type="text"][required], input[type="tel"][required]').forEach(input => {
            input.setCustomValidity(input.value.trim() ? '' : 'Please enter a value, not just spaces.');
          });
          if (!form.reportValidity()) return;
          const values = new FormData(form);
          const email = String(values.get('email')).trim();
          const note = String(values.get('message')).trim();
          const message = [
            'Hello ICT Mates, I’m interested in a Webstore.pk webshop.', '',
            `Name: ${String(values.get('name')).trim()}`,
            `Business: ${String(values.get('business')).trim()}`,
            `City: ${String(values.get('city')).trim()}`,
            `Phone: ${String(values.get('phone')).trim()}`,
            ...(email ? [`Email: ${email}`] : []),
            `Plan preference: ${planLabels[plan.value]}`,
            '', note || 'Please contact me about setting up my online store.',
          ].join('\n');
          if ((event as SubmitEvent).submitter !== prepare) {
            await deliverEmail();
            return;
          }
          messageText.textContent = message;
          whatsapp.href = `https://wa.me/923005551575?text=${encodeURIComponent(message)}`;
          preview.hidden = false;
          status.textContent = 'Your WhatsApp message is ready to review below. It has not been sent to WhatsApp.';
          whatsapp.focus({ preventScroll:true });
        });
      }
    </script>
    <script src="../scripts/active-navigation.ts"></script>
  </body>
</html>
<style>
  #contact { grid-template-columns:1fr 1.15fr; align-items:start; }
  .store-direct { border-top:1px solid rgb(255 255 255 / 25%); margin-top:28px; padding-top:20px; }
  .store-direct p { margin:0 0 12px; }
  .store-direct .text-link { display:inline-block; margin:12px 0 20px; color:#d8f3f1; }
  .store-phone { display:block; width:fit-content; color:#fff; font-family:'Manrope',sans-serif; font-size:clamp(23px,2.3vw,30px); font-weight:700; }
  .store-phone:hover { text-decoration:underline; }
  .store-form-panel { background:#fff; color:var(--ink); padding:24px; border-radius:16px; min-width:0; box-shadow:var(--shadow-card); }
  .store-form-panel h3 { font-size:24px; margin:0 0 8px; }
  .store-form-panel .form-intro,.store-form-panel .form-status,.store-form-panel .send-note { color:var(--muted); font-size:12px; margin:0 0 12px; }
