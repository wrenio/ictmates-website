---
import GoogleTagManager from '../components/GoogleTagManager.astro';
import SocialShareMeta from '../components/SocialShareMeta.astro';
import '../styles/global.css';
import '../styles/webstore.css';

const title = 'Compare Webstore.pk, Shopify and WooCommerce in Pakistan | Webstore.pk';
const description = 'Compare webshop prices, hosting and support for businesses in Pakistan. See how Webstore.pk, Shopify Basic and WooCommerce differ and what to budget for.';
const canonical = 'https://webstore.pk/why-wrenio/';
const whatsapp = 'https://wa.me/923005551575?text=Hello%20ICT%20Mates%2C%20I%27d%20like%20a%20Webstore.pk%20walkthrough.';
---
<!doctype html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/dm-sans-latin-v17.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-v23.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#101b8e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <SocialShareMeta />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="announcement">Webstore.pk by ICT Mates <span>·</span> Powered by Wrenio Commerce</div>
    <header class="site-header">
      <div class="header wrap">
        <a class="logo" href="/" aria-label="Webstore.pk home"><img src="/webstore-logo.webp" alt="Webstore.pk" width="600" height="132" /></a>
        <button class="menu-toggle" type="button" aria-controls="header-menu" aria-expanded="false">Menu</button>
        <div class="header-menu" id="header-menu">
          <nav aria-label="Main navigation"><a href="/">Home</a><a href="#comparison">Compare costs</a><a href="/#pricing">Pricing</a><a href="/partners/">Partners</a><a href="/login/">Store login</a></nav>
          <a class="button small" href="#talk">Let’s talk <span aria-hidden="true">↗︎</span></a>
        </div>
      </div>
    </header>
    <main id="main">
      <section class="compare-hero wrap" aria-labelledby="compare-title">
        <div>
          <div class="eyebrow">WHY WEBSTORE.PK?</div>
          <h1 id="compare-title">Your shop.<br />Clear costs.<br /><em>A local team.</em></h1>
          <p class="intro">Compare three ways to run an online shop in Pakistan. See what’s included, what you’ll manage yourself and which costs to plan for.</p>
          <div class="actions">
            <a class="button" href="/#pricing">See Webstore plans <span aria-hidden="true">↗︎</span></a>
            <a class="text-link" href="#comparison">Compare your options <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <aside class="offer" aria-labelledby="offer-title">
          <div class="eyebrow">YOUR OWN WEBSTORE.PK WEBSHOP</div>
          <h2 id="offer-title">Your brand.<br />Your own store.</h2>
          <p class="offer-price">Rs. 3,000 <span>/ month</span></p>
          <p>Or <strong>Rs. 30,000 per year</strong>, saving Rs. 6,000 over 12 monthly payments.</p>
          <ul>
            <li>A dedicated webshop and webstore.pk address</li>
            <li>Product and order management with built-in AI help</li>
            <li>Hosting and local support from ICT Mates</li>
            <li>No marketplace sales commission</li>
          </ul>
          <p class="offer-note">Custom domain registration, payment services and courier charges are separate.</p>
        </aside>
      </section>

      <section class="section wrap" id="comparison" aria-labelledby="comparison-title">
        <div class="section-heading">
          <div><div class="eyebrow">LOOK BEYOND THE STARTING PRICE</div><h2 id="comparison-title">What will your<br /><em>shop actually cost?</em></h2></div>
          <p>Compare subscription and hosting costs alongside setup, support and the time you’ll spend maintaining the shop.</p>
        </div>
        <p class="comparison-hint">Scroll the table sideways to see all three options.</p>
        <div class="comparison-scroll" role="region" aria-label="Webshop cost comparison" tabindex="0">
          <table>
            <caption>Illustrative costs for a business in Pakistan · checked 8 November 2026</caption>
            <thead>
              <tr><th scope="col">What to consider</th><th scope="col" class="webstore-option">Webstore.pk</th><th scope="col">Shopify Basic</th><th scope="col">WooCommerce</th></tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Starting platform cost</th>
                <td class="webstore-option"><strong>Rs. 3,000/month</strong><br />or Rs. 30,000/year</td>
                <td><strong>USD 25/month</strong><br />or USD 228/year, billed yearly</td>
                <td><strong>Free core software</strong><br />Hosting and other services are separate</td>
              </tr>
              <tr>
                <th scope="row">Annual cost example</th>
                <td class="webstore-option"><strong>Rs. 30,000</strong><br />Annual plan with hosting and local support</td>
                <td><strong>About Rs. 63,840</strong><br />USD 228 at an illustrative Rs. 280 per USD</td>
                <td><strong>Rs. 5,490 for hosting alone</strong><br />HosterPK’s entry WordPress plan. Check whether it fits your store and what it costs to renew.</td>
              </tr>
              <tr>
                <th scope="row">Day-to-day work</th>
                <td class="webstore-option">Manage products and orders in your own admin panel. Use built-in AI to draft product content.</td>
                <td>Manage the store in Shopify’s admin and add apps as needed.</td>
                <td>Manage WordPress, WooCommerce and your plugins, or arrange help.</td>
              </tr>
              <tr>
                <th scope="row">Hosting and support</th>
                <td class="webstore-option">Hosting and local support from ICT Mates in Lahore.</td>
                <td>Shopify includes hosting and support. Help with apps and custom work depends on the provider.</td>
                <td>Choose a host and arrange plugin support and maintenance according to your setup.</td>
              </tr>
              <tr>
                <th scope="row">Budget for separately</th>
                <td class="webstore-option">Custom domain registration, payment and courier charges, other third-party services and any custom work.</td>
                <td>Custom domain, paid apps, taxes and currency conversion charges. Payment and transaction fees depend on your setup.</td>
                <td>Domain, hosting, any paid plugins or themes, payment processing and any maintenance or developer work.</td>
              </tr>
              <tr>
                <th scope="row">A good fit when…</th>
                <td class="webstore-option">You want a managed shop with predictable rupee pricing and a local team.</td>
                <td>You want a hosted platform with a broad app ecosystem and are comfortable with USD billing.</td>
                <td>You want control over the setup and can maintain it yourself or hire help.</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="comparison-note">These examples cover different services. Compare the costs for the setup you need, including domains, apps, payment fees and any technical help. The Shopify conversion uses an example rate. Your bank’s rate, fees and taxes can change the amount you pay.</p>
      </section>

      <section class="demo-section wrap" aria-labelledby="managed-title">
        <div class="demo-copy">
          <div class="eyebrow">MORE TIME FOR YOUR BUSINESS</div>
          <h2 id="managed-title">One subscription for your shop, hosting and support.</h2>
          <p>Webstore.pk gives you a dedicated storefront powered by Wrenio Commerce. Manage your catalogue and orders while ICT Mates handles hosting and helps you get started.</p>
          <a class="button light" href="/#how-it-works">See how it works <span aria-hidden="true">↗︎</span></a>
        </div>
        <div class="platform-card">
          <div class="eyebrow">WHAT COMES WITH YOUR STORE</div>
          <h3>Built around your business.</h3>
          <ul>
            <li><span aria-hidden="true">01</span> Your brand and a webstore.pk address</li>
            <li><span aria-hidden="true">02</span> Product and order management</li>
            <li><span aria-hidden="true">03</span> AI help for product copy and image alt text</li>
            <li><span aria-hidden="true">04</span> A storefront optimized for search and AI discovery</li>
          </ul>
        </div>
      </section>

      <section class="section wrap" aria-labelledby="details-title">
        <div class="eyebrow">CLEAR BEFORE YOU COMMIT</div>
        <h2 id="details-title">Know what’s included.</h2>
        <div class="feature-grid">
          <article class="feature-card"><h3>Your domain</h3><p>Your webstore.pk address is included. You can connect a domain you already own or ask us to register one for Rs. 4,200 for two years.</p></article>
          <article class="feature-card"><h3>Your selling costs</h3><p>Webstore.pk takes no marketplace commission on sales through your dedicated shop. Payment providers, couriers and other third parties may charge separately.</p></article>
          <article class="feature-card"><h3>Your requirements</h3><p>Moving a store or planning a custom setup? Talk to our team about the scope, support and any additional cost before choosing a plan.</p></article>
        </div>
      </section>

      <section class="contact wrap" id="talk" aria-labelledby="talk-title">
        <div>
          <div class="eyebrow">TALK TO A LOCAL TEAM</div>
          <h2 id="talk-title">See how your shop could work.</h2>
          <p>Tell us what you sell and ask for a walkthrough. We’ll show you the storefront and admin panel, and help you work out what you’ll need.</p>
        </div>
        <div class="contact-actions">
          <a class="button lime" href="/#contact">Ask for a walkthrough <span aria-hidden="true">↗︎</span></a>
          <a class="contact-number" href={whatsapp} target="_blank" rel="noopener noreferrer">Chat on WhatsApp ↗︎</a>
        </div>
      </section>

      <section class="sources wrap" aria-labelledby="sources-title">
        <h2 id="sources-title">Pricing sources</h2>
        <p>Check the current prices and terms with each provider before choosing a setup.</p>
        <ul>
          <li><a href="https://www.shopify.com/pk/pricing" target="_blank" rel="noopener noreferrer">Shopify Pakistan pricing ↗︎</a></li>
          <li><a href="https://woocommerce.com/pricing/" target="_blank" rel="noopener noreferrer">WooCommerce pricing and cost guidance ↗︎</a></li>
          <li><a href="https://www.hosterpk.com/wordpress-hosting-pakistan" target="_blank" rel="noopener noreferrer">HosterPK WordPress hosting ↗︎</a></li>
        </ul>
      </section>
    </main>
    <footer class="wrap footer">
      <a class="logo" href="/"><img src="/webstore-logo.webp" alt="Webstore.pk" width="600" height="132" loading="lazy" /></a>
      <p>Your business. Your online store.</p>
      <nav aria-label="Footer navigation"><a href="/">Home</a><a href="/#pricing">Pricing</a><a href="/why-wrenio/" aria-current="page">Compare webshops</a><a href="/partners/">Partners</a><a href="/#contact">Contact</a></nav>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Webstore.pk · A service by <a href="https://ictmates.com/" target="_blank" rel="noopener noreferrer">ICT Mates</a>.</span><span>Powered by <a href="https://wreniocommerce.com/" target="_blank" rel="noopener noreferrer">Wrenio Commerce</a> · Built by <a href="https://wrenio.studio/" target="_blank" rel="noopener noreferrer">Wrenio Studio</a></span></div>
    </footer>
    <script src="../scripts/active-navigation.ts"></script>
  </body>
</html>

<style>
  .compare-hero { display:grid; grid-template-columns:1.2fr 1fr; align-items:center; gap:70px; padding-block:50px 70px; }
  .compare-hero h1 { font-size:clamp(48px,5.4vw,74px); text-shadow:var(--shadow-title); }
  .compare-hero .actions { flex-wrap:wrap; }
  .offer { background:var(--green); border-radius:22px; padding:35px; color:var(--white); box-shadow:var(--shadow-card); }
  .offer .eyebrow { color:#aee8e6; margin-bottom:15px; }
  .offer h2 { font-size:38px; }
  .offer p { color:#e4e9ff; }
  .offer-price { font:650 32px 'Manrope',sans-serif; margin-bottom:10px; }
  .offer-price span { font-size:14px; }
  .offer ul { list-style:none; padding:16px 0; border-block:1px solid #ffffff35; }
  .offer li { display:flex; gap:12px; padding-block:5px; font-size:14px; }
  .offer li::before { content:'✓'; color:#aee8e6; }
  .offer-note { font-size:12px; margin-bottom:0; }
  .comparison-hint { display:none; font-size:13px; }
  .comparison-scroll { overflow-x:auto; border:1px solid var(--line); border-radius:16px; background:var(--white); }
  .comparison-scroll:focus-visible { outline:3px solid #bf670e; outline-offset:5px; }
  table { border-collapse:collapse; width:100%; min-width:820px; table-layout:fixed; font-size:13px; line-height:1.6; }
  caption { text-align:left; padding:16px 19px; color:var(--muted); font-size:12px; }
  th,td { text-align:left; vertical-align:top; padding:18px 19px; border-top:1px solid var(--line); overflow-wrap:break-word; }
  thead th { background:var(--green); color:var(--white); font-size:16px; }
  thead th:first-child { width:19%; }
  tbody th { font-weight:600; }
  td { color:var(--muted); }
  td strong { color:var(--ink); }
  .webstore-option { background:#eaf7f5; }
  thead .webstore-option { background:var(--lime); color:var(--ink); }
  .comparison-note { font-size:13px; margin:20px 0 0; max-width:850px; }
  .sources { padding-top:45px; }
  .sources h2 { font-size:20px; }
  .sources p,.sources li { font-size:13px; }
  .sources ul { display:flex; flex-wrap:wrap; gap:10px 26px; list-style:none; padding:0; }
  .sources a { text-decoration:underline; text-underline-offset:4px; }
  .footer nav { flex-wrap:wrap; }
  @media(max-width:900px) {
    .comparison-hint { display:block; }
  }
  @media(max-width:720px) {
    .compare-hero { grid-template-columns:1fr; gap:30px; padding-block:30px 45px; }
    .offer { max-width:550px; padding:26px; }
    .footer nav { justify-content:flex-start; gap:12px 16px; }
  }
</style>
